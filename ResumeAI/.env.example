# Django Core Security & Networking
SECRET_KEY=replace-this-with-a-50-char-cryptographic-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False

# Database (PostgreSQL Connection Pooling or default SQLite)
USE_POSTGRES=false
DB_NAME=resumeai
DB_USER=resumeai_user
DB_PASSWORD=resumeai_secure_pass_2026
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis Distributed Sessions & Cache
USE_REDIS_CACHE=false
REDIS_URL=redis://127.0.0.1:6379/0

# Optional S3 / Cloudflare R2 Cloud Object Storage
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Google Gemini LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SEC=20.0

# Optional Adzuna Live Jobs API (Free tier: 250 req/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DAILY_CAP=220
