# Django Environment Configuration
SECRET_KEY=dev-secret-key-replace-in-production-with-random-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*
USE_POSTGRES=false

# Optional PostgreSQL Database Configuration (Leave blank for default SQLite)
DB_NAME=resumeai_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
